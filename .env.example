# Chik-Biz does NOT need any environment variables to run the demonstration.
# These are placeholders for a future Supabase-backed deployment only.
# Only the public anon/publishable key may ever be used in the frontend.
# NEVER put a service-role key in any VITE_* variable — it would be shipped to browsers.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
