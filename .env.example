# Optional. Without these the app runs in browser-only demo mode.
# With them, the start screen also offers "Sign in to your business" (live Supabase data).
#
# Only the PUBLIC project URL and publishable (or legacy anon) key belong here —
# they are shipped to every browser. Data is protected by sign-in and row-level
# security, not by keeping these values secret.
# NEVER put a service-role / secret key in any VITE_* variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
